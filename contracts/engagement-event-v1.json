{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eventpulse:engagement-event:v1",
  "type": "object",
  "required": ["event_id", "user_id", "event_type", "event_time", "ingested_at"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "user_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["view", "click", "purchase"]},
    "event_time": {"type": "integer", "minimum": 0},
    "ingested_at": {"type": "integer", "minimum": 0},
    "value_cents": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}

